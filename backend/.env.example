APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_API_KEY=
JWT_SECRET=replace-with-local-secret
DATABASE_URL=postgres://postgres:postgres@localhost:5432/trainsync
REDIS_URL=redis://localhost:6379/0

# Twilio Verify. Leave all three empty to disable phone verification.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Private directory for driver verification documents; keep outside the web root.
DRIVER_DOCUMENTS_PATH=private/driver-documents
DRIVER_DOCUMENTS_ENCRYPTION_KEY=

# Local OSRM road-routing endpoint. Leave empty to disable route geometry.
OSRM_BASE_URL=http://localhost:5000

# Google Routes API. Keep the key server-side; transit itineraries are disabled without it.
GOOGLE_MAPS_API_KEY=
