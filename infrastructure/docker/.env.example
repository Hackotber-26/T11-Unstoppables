# Local-only defaults. Copy to .env in this directory for Docker Compose.
POSTGRES_PASSWORD=local-postgres-password
REDIS_PASSWORD=local-redis-password
JWT_SECRET=local-development-only-secret-change-before-deploy-2026
APP_API_KEY=
GRAFANA_ADMIN_PASSWORD=local-grafana-change-me

# Host ports can be changed when a default is already occupied.
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
CADDY_HTTP_PORT=8081
CADDY_HTTPS_PORT=8444